{
    "mcpServers": {
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--headless",
                "--executablePath=/Applications/Chromium.app/Contents/MacOS/Chromium"
            ]
        },
        "context7": {
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "Authorization": "Bearer ${CONTEXT7_API_KEY}"
            },
            "exposure": "direct"
        }
    }
}
