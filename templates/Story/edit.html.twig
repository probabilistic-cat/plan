{% extends 'layout.html.twig' %}

{% if is_new %}
    {% set action = 'New' %}
    {% set submit_name = 'Create' %}
{% else %}
    {% set action = 'Edit' %}
    {% set submit_name = 'Update' %}
{% endif %}

{% block title %}{{ action }} Story{% endblock %}

{% block content %}
    <h1>{{ action }} Story</h1>

    {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-100'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-100', 'rows': 4}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.epic) }}
                {{ form_widget(form.epic) }}
            {{ form_errors(form.epic) }}
        </div>

        <div class="form-group">
            {{ form_label(form.storyTags) }}
            <div class="autocomplete-wrapper">
                <div id="tag-chips" class="tag-chips"></div>
                <input type="text" id="tag-search" class="tag-chips-input" placeholder="Search and select tags..." />
                <div id="tag-dropdown" class="autocomplete-dropdown"></div>
                {{ form_widget(form.storyTags) }}
            </div>
            {{ form_errors(form.storyTags) }}
        </div>

        <button type="submit">{{ submit_name }}</button>
    {{ form_end(form) }}

    <p><a href="{{ path('story_index') }}">Back to list</a></p>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script>
    $(() => {
        // Tags autocomplete
        const tagDropdown = $('#tag-dropdown');
        const tagSearch = $('#tag-search');
        const tagChips = $('#tag-chips');
        const tagSelect = $('#{{ form.storyTags.vars.id }}');
        let allTags = {{ tags|default('[]')|raw }};
        let selectedTags = {{ selected_tag_ids|default('[]')|raw }};

        // Render existing tags as chips
        renderTagChips();

        tagSearch.on('input', function() {
            const query = $(this).val().toLowerCase();
            const filtered = allTags.filter(function(tag) {
                return tag.name.toLowerCase().includes(query) && !selectedTags.includes(tag.id);
            });
            renderDropdown(tagDropdown, filtered, function(tag) {
                selectedTags.push(tag.id);
                renderTagChips();
                tagSearch.val('');
                updateTagSelect();
            });
        });

        function renderTagChips() {
            tagChips.empty();
            const selectedTagObjects = allTags.filter(function(t) {
                return selectedTags.includes(t.id);
            });
            selectedTagObjects.forEach(function(tag) {
                const chip = $('<span class="tag-chip"></span>');
                chip.text(tag.name);
                const removeBtn = $('<span class="remove">&times;</span>');
                removeBtn.on('click', function() {
                    selectedTags = selectedTags.filter(function(id) { return id !== tag.id; });
                    renderTagChips();
                    updateTagSelect();
                });
                chip.append(removeBtn);
                tagChips.append(chip);
            });
        }

        function updateTagSelect() {
            tagSelect.val(selectedTags);
        }

        function renderDropdown($dropdown, items, onSelect) {
            $dropdown.empty();
            if (items.length === 0) {
                $dropdown.hide();
                return;
            }
            items.forEach(function(item, index) {
                const $option = $('<div class="option"></div>').text(item.name);
                $option.on('click', function() { onSelect(item); });
                $dropdown.append($option);
            });
            $dropdown.show();
        }

        // Close dropdowns on outside click
        $(document).on('click', function(e) {
            if (!$(e.target).closest('.autocomplete-wrapper').length) {
                tagDropdown.hide();
            }
        });
    });
    </script>
{% endblock %}
