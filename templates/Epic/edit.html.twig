{% extends 'layout.html.twig' %}

{% if is_new %}
    {% set action = 'New' %}
    {% set submit_name = 'Create' %}
{% else %}
    {% set action = 'Edit' %}
    {% set submit_name = 'Update' %}
{% endif %}

{% block title %}{{ action }} Epic{% endblock %}

{% block content %}
    <h1>{{ action }} Epic</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">{{ submit_name }}</button>
        <a href="{{ path('epic_index') }}">Cancel</a>
    {{ form_end(form) }}
{% endblock %}
