{% extends "layout.html.twig" %}

{% block css %}
    {{ parent() }}
    <link href="{{ asset('css/content_login.css') }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block content %}
    <div class="sign_form">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="sign_element" id="sign_form_submit">Sign up</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
