{% extends 'layout.html.twig' %}

{% block title %}Tags{% endblock %}

{% block content %}
    <h1>Tags</h1>

    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}

    <p><a href="{{ path('tag_new') }}">Create Tag</a></p>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Tasks</th>
                <th>Stories</th>
                <th>Epics</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for tag in tags %}
                <tr>
                    <td>
                        <a href="{{ path('tag_show', {id: tag.id}) }}">{{ tag.name }}</a>
                    </td>
                    <td class="epicsCount">{{ tag.epicCount }}</td>
                    <td class="storiesCount">{{ tag.storyCount }}</td>
                    <td class="tasksCount">{{ tag.taskCount }}</td>
                    <td>
                        <a href="{{ path('tag_edit', {id: tag.id}) }}">Edit</a>
                        <form method="post" action="{{ path('tag_delete', {id: tag.id}) }}" style="display:inline" onsubmit="return confirm('Are you sure?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ tag.id) }}">
                            <button type="submit" id="delete-tag-{{ tag.id }}">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No tags found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
