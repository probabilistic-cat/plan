{% extends "base.html.twig" %}

{% block title %}Plan{% endblock %}

{% block css %}
    {{ parent() }}
    <link href="{{ asset("css/base.css") }}" type="text/css" rel="stylesheet" />
    <link href="{{ asset("css/sidebar.css") }}" type="text/css" rel="stylesheet" />
    <link href="{{ asset("css/footer.css") }}" type="text/css" rel="stylesheet" />
{% endblock %}
{% block js %}
    {{ parent() }}
    <script src="{{ asset("js/jquery-3.7.1.min.js") }}"></script>
{% endblock %}

{% block body %}
    <div class="app-layout">
        <div class="sidebar headfoot">
            <p class="logo"><a href="{{ path("route_index") }}">Plan</a></p>
            <nav class="nav">
                <a href="{{ path("route_index") }}" class="nav-link {{ active_section == 'board' ? 'active' : '' }}">Board</a>
                <a href="{{ path("epic_index") }}" class="nav-link {{ active_section == 'epics' ? 'active' : '' }}">Epics</a>
                <a href="{{ path("story_index") }}" class="nav-link {{ active_section == 'stories' ? 'active' : '' }}">Stories</a>
                <a href="{{ path("task_index") }}" class="nav-link {{ active_section == 'tasks' ? 'active' : '' }}">Tasks</a>
                <a href="{{ path("tag_index") }}" class="nav-link {{ active_section == 'tags' ? 'active' : '' }}">Tags</a>
            </nav>
        </div>

        <div class="main">
            <div class="topbar headfoot">
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <p class="user_actions">
                        <a href="{{ path("route_logout") }}">Log out</a>
                    </p>
                    <p class="user_actions">
                        <a href="#">{{ app.user.name }}</a>
                    </p>
                {% else %}
                    <p class="user_actions">
                        <a href="{{ path("route_signup") }}">Sign up</a>
                    </p>
                    <p class="user_actions">
                        <a href="{{ path("route_login") }}">Log in</a>
                    </p>
                {% endif %}
            </div>

            <div class="content">
                {% block content %}{% endblock %}
            </div>

            <div class="footer headfoot">
                <p>footer</p>
            </div>
        </div>
    </div>
{% endblock %}

